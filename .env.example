
 
OPENAI_API_KEY= # Your OpenAI API Key here


LANGSMITH_TRACING="true"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY= # Your LangSmith API Key here
LANGSMITH_PROJECT= # Your LangSmith Project Name 


# Neo4j Configuration
NEO4J_URI= # Your Neo4j URI here, e.g., bolt://localhost:7687
NEO4J_USERNAME= # Neo4j username
NEO4J_PASSWORD= # Neo4j password
NEO4J_DATABASE= neo4j # (graphiti only works with the default database)


# Postgres Configuration
POSTGRES_HOST= # Configured Postgres host 
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Langgraph Configuration
LANGGRAPH_API_SERVER= # Langgraph API server URL, e.g., http://localhost:2024

#DISABLE GRAPHITI TELEMETRY
GRAPHITI_TELEMETRY_ENABLED=false